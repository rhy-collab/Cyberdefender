{
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/industries/therapists",
      "destination": "/industries/therapists.html"
    },
    {
      "source": "/security-notice",
      "destination": "/security-notice.html"
    },
    {
      "source": "/radar",
      "destination": "/radar.html"
    }
  ],
  "redirects": [
    {
      "source": "/therapists.html",
      "destination": "/industries/therapists",
      "permanent": true
    }
  ]
}
